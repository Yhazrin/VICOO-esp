# ============================================
# VICOO — Environment Variables for Easy Deploy
# All secrets are pre-generated for demo use.
# Change them before any production deployment.
# ============================================

# Application
APP_ENV=development
APP_NAME=VICOO API
# 生产/预发首次部署、库为空时需要演示商品与用户：设为 true（有用户后不会再种）
SEED_IF_EMPTY=false

# MySQL — change before production!
MYSQL_ROOT_PASSWORD=CHANGEME_mysql_root_password
MYSQL_DATABASE=vicoo
MYSQL_USER=vicoo
MYSQL_PASSWORD=CHANGEME_mysql_password

# Secrets — MUST be changed before any production deployment!
# Generate new ones with: openssl rand -hex 32
APP_SECRET_KEY=CHANGEME_GENERATE_WITH_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_openssl_rand_hex_32

# JWT
JWT_ALGORITHM=HS256

# CORS
# 若手机打开「虚拟机上的支付页」而 API 指向本机 Docker：请把虚拟机站点 origin 一并列入，例如 http://csi420-02-vm8.ucd.ie
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://127.0.0.1,http://localhost:8000,http://localhost:5173,http://localhost:9111

# Frontend (for local .env if not using docker default)
VITE_API_BASE_URL=/api/v1

# 扫码支付二维码里的站点根 URL（无尾斜杠），须与用户浏览器访问本站的协议+主机一致；staging 示例见下行
# 不设则前端用当前页 origin（在 localhost 打开时手机扫码会打不开）
# VITE_PUBLIC_SITE_ORIGIN=https://csi420-02-vm8.ucd.ie
VITE_PUBLIC_SITE_ORIGIN=

# 仅静态「支付确认页」部署在虚拟机、订单在本机 Docker 时：虚拟机上前端构建须允许 apiBase 指向开发机。
# 逗号分隔主机匹配规则：精确 host、前缀 host 以「.」结尾（如 192.168.）、后缀以「.」开头（如 .ngrok-free.app）
# VITE_PAY_API_BASE_ALLOW_HOSTS=192.168.,10.,127.0.0.1,localhost
VITE_PAY_API_BASE_ALLOW_HOSTS=

# Seed passwords (demo accounts) — change before production!
SEED_ADMIN_PASSWORD=CHANGEME_admin_password
SEED_EDITOR_PASSWORD=CHANGEME_editor_password
SEED_USER_PASSWORD=CHANGEME_user_password
MOCK_USER_PASSWORD=CHANGEME_mock_password

# Resend Mailer (Optional)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=VICOO <onboarding@vicoo.yhazrin.xyz>

# AI — OpenAI (Required for AI features)
# Current MVP only needs OPENAI_API_KEY; embeddings/vector DB are not enabled yet.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Redis (Optional but recommended for production) — change before production!
REDIS_PASSWORD=CHANGEME_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (需要填写)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payments — WeChat Pay (Mini Program / JSAPI)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_NOTIFY_URL=http://localhost:8000/api/v1/payments/wechat-notify

# Payments — Alipay (Web)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8000/api/v1/payments/alipay-notify

# Frontend URL (for OAuth callback redirect)
FRONTEND_URL=http://localhost

# Password reset OTP pepper. Generate with: openssl rand -hex 32
# MUST be set in production. The app will refuse to start in production
# (APP_ENV != development) without this set to a non-default value.
PASSWORD_RESET_OTP_PEPPER=CHANGEME_GENERATE_WITH_openssl_rand_hex_32

# Public VPS + host nginx (docker-compose.host-nginx.yml), example:
# CORS_ORIGINS=https://vicoo.yhazrin.xyz
# FRONTEND_URL=https://vicoo.yhazrin.xyz
# VITE_PUBLIC_SITE_ORIGIN=https://vicoo.yhazrin.xyz
# 宿主机 Nginx 反代到 127.0.0.1:9080 时设为 1（compose-up-staging.sh 会加载本项）
# VICOO_USE_HOST_NGINX=1
